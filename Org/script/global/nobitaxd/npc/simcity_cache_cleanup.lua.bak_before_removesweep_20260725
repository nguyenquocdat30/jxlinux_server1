-- Doc + don entry rac cua SimCore.fighterList khi no con tro nham vao npc vua duoc tao.
-- CHI xoa entry (khong goi SimCore:Remove, khong DelNpc gi ca), va CHI xoa khi entry
-- khong co children (de an toan, tranh anh huong nhom cong dan phu thuoc).
function TanThu_SimCityCacheClean(nNpcIndex)
	if not nNpcIndex or nNpcIndex <= 0 then return 0 end
	if not SimCore or not SimCore.fighterList then return 0 end
	local nCleaned = 0
	for nKey, tbNpc in SimCore.fighterList do
		if tbNpc and tbNpc.finalIndex == nNpcIndex then
			local nChildCount = 0
			if tbNpc.children then nChildCount = getn(tbNpc.children) end
			if nChildCount == 0 then
				SimCore.fighterList[nKey] = nil
				if SimCore.totalFighters and SimCore.totalFighters > 0 then
					SimCore.totalFighters = SimCore.totalFighters - 1
				end
				if SimCore.removedIds then
					tinsert(SimCore.removedIds, nKey)
				end
				nCleaned = nCleaned + 1
			end
		end
	end
	return nCleaned
end

-- Theo doi 1 danh sach npc (cay/moc nhan/boss) va dinh ky don cache SimCity cho tung con,
-- de phong truong hop SimCity cham vao SAU khi da tao (khong chi luc vua tao xong).
-- Dung AddTimer (hen gio toan cuc, ten ham rieng) - KHONG dung SetNpcTimer/OnTimer vi
-- OnTimer la ten dung chung toan cuc, tung lam hong AI cua npc khac khi bi ghi de.
TANTHU_TRACKED_NPCS = TANTHU_TRACKED_NPCS or {}
TANTHU_SWEEP_RUNNING = TANTHU_SWEEP_RUNNING or 0

function TanThu_TrackNpc(nNpcIndex)
	if not nNpcIndex or nNpcIndex <= 0 then return end
	tinsert(TANTHU_TRACKED_NPCS, nNpcIndex)
	if TANTHU_SWEEP_RUNNING == 0 and AddTimer then
		TANTHU_SWEEP_RUNNING = 1
		AddTimer(3*18, "TanThu_ProtectSweep", 0)
	end
end

function TanThu_ProtectSweep(nParam)
	local tbAlive = {}
	for i = 1, getn(TANTHU_TRACKED_NPCS) do
		local nNpcIdx = TANTHU_TRACKED_NPCS[i]
		if nNpcIdx and nNpcIdx > 0 and GetNpcSettingIdx and GetNpcSettingIdx(nNpcIdx) and GetNpcSettingIdx(nNpcIdx) > 0 then
			TanThu_SimCityCacheClean(nNpcIdx)
			tinsert(tbAlive, nNpcIdx)
		end
	end
	TANTHU_TRACKED_NPCS = tbAlive
	if getn(TANTHU_TRACKED_NPCS) > 0 and AddTimer then
		AddTimer(3*18, "TanThu_ProtectSweep", 0)
	else
		TANTHU_SWEEP_RUNNING = 0
	end
end
